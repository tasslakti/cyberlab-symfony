{% extends 'base.html.twig' %}

{% block title %}Réserver {{ lab.title }} - CyberLab{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="lab-card">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <h1 class="h3">
                                <i class="fas fa-calendar-plus me-2"></i>Réserver un Lab
                            </h1>
                            <p class="text-secondary">Planifiez votre session de pratique</p>
                        </div>

                        <div class="lab-preview mb-4 p-4 bg-dark rounded">
                            <h4 class="text-primary">{{ lab.title }}</h4>
                            <p class="text-light mb-2">{{ lab.description }}</p>
                            <div class="d-flex gap-3">
                            <span class="badge bg-{{ lab.difficulty == 'easy' ? 'success' : (lab.difficulty == 'medium' ? 'warning' : 'danger') }}">
                                Difficulté: {{ lab.difficulty|upper }}
                            </span>
                                <span class="badge bg-secondary">
                                <i class="fas fa-clock me-1"></i>{{ lab.duration }} min
                            </span>
                            </div>
                        </div>

                        {{ form_start(form, {'attr': {'class': 'reservation-form'}}) }}
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.startTime, 'Date de début', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.startTime, {'attr': {'class': 'form-control'}}) }}
                                    <div class="form-text">Sélectionnez la date et l'heure de début</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.endTime, 'Date de fin', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.endTime, {'attr': {'class': 'form-control'}}) }}
                                    <div class="form-text">Sélectionnez la date et l'heure de fin</div>
                                </div>
                            </div>
                        </div>

                        <div class="reservation-summary p-3 bg-dark rounded mb-4">
                            <h6 class="text-primary">Résumé de la réservation</h6>
                            <div class="row text-sm">
                                <div class="col-6">
                                    <small class="text-secondary">Lab:</small>
                                    <div class="text-light">{{ lab.title }}</div>
                                </div>
                                <div class="col-6">
                                    <small class="text-secondary">Utilisateur:</small>
                                    <div class="text-light">{{ app.user.firstName }} {{ app.user.lastName }}</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-calendar-check me-2"></i>Confirmer la Réservation
                            </button>
                            <a href="{{ path('lab_show', {id: lab.id}) }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startTimeInput = document.querySelector('#reservation_startTime');
            const endTimeInput = document.querySelector('#reservation_endTime');

            startTimeInput.addEventListener('change', function() {
                const startTime = new Date(this.value);
                const endTime = new Date(startTime.getTime() + 60 * 60 * 1000); // +1 hour

                endTimeInput.value = endTime.toISOString().slice(0, 16);
            });
        });
    </script>
{% endblock %}