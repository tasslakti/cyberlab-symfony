{% extends 'base.html.twig' %}

{% block title %}Modifier catégorie{% endblock %}

{% block body %}
    <h2>Modifier la catégorie</h2>

    <div class="card p-4">
        {{ form_start(form) }}
        {{ form_widget(form, {'attr': {'class': 'form-control mb-3'}}) }}
        <button type="submit" class="btn btn-primary">Modifier</button>
        {{ form_end(form) }}
    </div>

    <a href="{{ path('categorie_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
{% endblock %}
