{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
    <h2 class="mb-4">Liste des catégories</h2>

    <a href="{{ path('categorie_new') }}" class="btn btn-primary mb-3">Ajouter une catégorie</a>

    <table class="table table-striped table-bordered">
        <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for c in categories %}
            <tr>
                <td>{{ c.id }}</td>
                <td>{{ c.nom }}</td>
                <td>
                    <a href="{{ path('categorie_edit', {id: c.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    <a href="{{ path('categorie_delete', {id: c.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Supprimer ?')">Supprimer</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3">Aucune catégorie</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
